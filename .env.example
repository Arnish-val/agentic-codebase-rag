# =============================================================================
# Agentic Codebase Intelligence Platform — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── LLM API ──────────────────────────────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Anthropic API key (direct, fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Primary model for generation/verification
LLM_GENERATION_MODEL=anthropic/claude-sonnet-4-5
# Fast model for routing/classification
LLM_ROUTER_MODEL=anthropic/claude-haiku-4-5
# LLM API base URL (set to https://api.anthropic.com/v1 for direct Anthropic)
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── MongoDB ───────────────────────────────────────────────────────────────────
# For local dev with docker-compose: mongodb://admin:devpassword@localhost:27017/agentic?authSource=admin
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/agentic
MONGODB_URI=mongodb://admin:devpassword@localhost:27017/agentic?authSource=admin
MONGODB_DB_NAME=agentic
# Local dev only
MONGO_USER=admin
MONGO_PASSWORD=devpassword

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_QUERY_CACHE=300
REDIS_TTL_EMBEDDING_CACHE=86400

# ── Embedding & Reranker Services ─────────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://localhost:8080
RERANKER_SERVICE_URL=http://localhost:8081
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Secret for signing API keys (min 32 chars)
API_KEY_SECRET=change_this_to_a_long_random_secret_min_32_chars
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Agent Service ─────────────────────────────────────────────────────────────
AGENTS_PORT=3002
AGENTS_URL=http://localhost:3002

# ── Docker Sandbox ────────────────────────────────────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_PYTHON_IMAGE=agentic-sandbox-python:latest
SANDBOX_NODE_IMAGE=agentic-sandbox-node:latest
SANDBOX_SHELL_IMAGE=agentic-sandbox-shell:latest
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000

# ── Retrieval Config ──────────────────────────────────────────────────────────
# RRF parameters
RRF_K=60
RRF_ALPHA_BM25=0.4
RRF_ALPHA_VECTOR=0.6
# Top-k per stage
RETRIEVAL_TOP_K_BM25=50
RETRIEVAL_TOP_K_VECTOR=50
RETRIEVAL_TOP_K_RERANK=10

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_QUERY=30
RATE_LIMIT_MAX_GENERAL=120
RATE_LIMIT_MAX_ADMIN=10

# ── Session Config ────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=86400

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
